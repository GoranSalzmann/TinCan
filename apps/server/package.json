{
  "name": "@tincan/server",
  "version": "0.1.0",
  "private": true,
  "description": "Tin Can app server: module loader, REST API, WebSocket gateway, admin CLI",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx --conditions=tincan-src --watch src/cli.ts serve --config ../../dev/config.yaml"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@tincan/auth": "workspace:*",
    "@tincan/db": "workspace:*",
    "@tincan/pubsub": "workspace:*",
    "@tincan/shared": "workspace:*",
    "@tincan/storage": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "tincan": "dist/cli.js"
  }
}
